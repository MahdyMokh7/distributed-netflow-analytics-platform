pipeline {
    agent any

    environment {
        IMAGE_NAME = 'nimbo'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        MAVEN_OPTS = '-Xmx1024m'

        SPRING_PROFILES_ACTIVE = 'prod'
    }

    parameters {
        choice(
                name: 'DEPLOY_ACTION',
                choices: ['deploy', 'test-only', 'build-only'],
                description: 'Deploy action to perform'
        )
        booleanParam(
                name: 'SKIP_TESTS',
                defaultValue: false,
                description: 'Skip unit tests'
        )
        booleanParam(
                name: 'SKIP_INTEGRATION_TESTS',
                defaultValue: false,
                description: 'Skip integration tests (uses local containers)'
        )
        string(
                name: 'KAFKA_OVERRIDE',
                defaultValue: '',
                description: 'Override Kafka bootstrap servers (leave empty to use default)'
        )
        string(
                name: 'HDFS_OVERRIDE',
                defaultValue: '',
                description: 'Override HDFS URI (leave empty to use default)'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                script {
                    if (params.SKIP_TESTS) {
                        sh 'mvn -q -B clean package -DskipTests'
                    } else {
                        sh 'mvn -q -B clean package'
                    }
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                }
            }
        }

        stage('Unit Tests') {
            when {
                expression { !params.SKIP_TESTS }
            }
            steps {
                sh 'mvn -q -B test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('Integration Tests') {
            when {
                expression { !params.SKIP_TESTS && !params.SKIP_INTEGRATION_TESTS }
            }
            steps {
                script {
                    sh 'mvn -q -B verify -Pintegration-test'
                }
            }
            post {
                always {
                    junit 'target/failsafe-reports/*.xml'
                    sh 'docker compose -f docker-compose.yml down --volumes || true'
                }
            }
        }

        stage('Build Docker Image') {
            when {
                expression { params.DEPLOY_ACTION == 'deploy' }
            }
            steps {
                sh """
                    docker build -t ${IMAGE_NAME}:latest -t ${IMAGE_NAME}:${IMAGE_TAG} .
                """
            }
        }

        stage('Deploy') {
            when {
                expression { params.DEPLOY_ACTION == 'deploy' }
            }
            steps {
                script {
                    def kafkaServers = params.KAFKA_OVERRIDE ?: env.KAFKA_BOOTSTRAP_SERVERS
                    def hdfsUri = params.HDFS_OVERRIDE ?: env.HDFS_URI

                    sh 'docker stop nimbo-ingester 2>/dev/null || true'
                    sh 'docker rm nimbo-ingester 2>/dev/null || true'

                    sh """
                        docker run -d \
                            --name nimbo-ingester \
                            --restart unless-stopped \
                            -e KAFKA_BOOTSTRAP_SERVERS=${kafkaServers} \
                            -e HDFS_URI=${hdfsUri} \
                            -e KAFKA_TOPIC=${env.KAFKA_TOPIC} \
                            -e KAFKA_CONSUMER_GROUP=${env.KAFKA_CONSUMER_GROUP} \
                            -e HDFS_BASE_PATH=${env.HDFS_BASE_PATH} \
                            -e SPRING_PROFILES_ACTIVE=prod \
                            -p 8080:8080 \
                            ${IMAGE_NAME}:latest
                    """

                    sh 'sleep 10'

                    def deploy = sh(
                            script: 'curl -s http://localhost:8080/actuator/health',
                            returnStatus: true
                    )

                    if (deploy != 0) {
                        error 'Deployment failed: Health check failed'
                    }

                    echo '✅ Deployment successful!'
                }
            }
        }
    }

    post {
        always {
            sh 'docker system prune -f || true'
        }
        success {
            echo '✅ Pipeline completed successfully!'
        }
        failure {
            echo '❌ Pipeline failed!'
        }
    }
}