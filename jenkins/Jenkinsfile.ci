pipeline {
    agent {
        docker {
            label 'nimbo-nimbyte'
            image 'maven:3.9-eclipse-temurin-17'

            args '''
                --network host
                --add-host sonarqube.inside.sahab.ir:192.168.12.53
                -v /var/run/docker.sock:/var/run/docker.sock
                --group-add 999
                -v /home/team1/.m2:/home/team1/.m2
                -v /opt/jdk-17.0.6/lib/security/cacerts:/certs/cacerts:ro
                -v /etc/passwd:/etc/passwd:ro
                -v /etc/group:/etc/group:ro
            '''
        }
    }

    options {
        timestamps()
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        SPRING_PROFILES_ACTIVE = 'prod'
        MAVEN_OPTS = '-Djavax.net.ssl.trustStore=/certs/cacerts'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                sh '''
                    mvn \
                      --settings jenkins/maven-settings.xml \
                      --batch-mode \
                      --no-transfer-progress \
                      clean verify \
                '''
            }
        }

        stage('Run Sonar Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''
                        set -eu
                        mkdir -p /tmp/sonar-cache

                        CHANGE="${GERRIT_CHANGE_NUMBER:-manual-build}"
                        PATCHSET="${GERRIT_PATCHSET_NUMBER:-0}"

                        mvn \
                          --settings jenkins/maven-settings.xml \
                          --batch-mode \
                          --no-transfer-progress \
                          org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                          -Dsonar.projectKey=nimbo-nimbyte \
                          -Dsonar.projectName=nimbo-nimbyte \
                          -Dsonar.host.url="${SONAR_HOST_URL}" \
                          -Dsonar.login="${SONAR_AUTH_TOKEN}" \
                          -Dsonar.userHome=/tmp/sonar-cache \
                          -Dsonar.pullrequest.key="${CHANGE}" \
                          -Dsonar.pullrequest.branch="gerrit-${CHANGE}-${PATCHSET}" \
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {
        always {
            junit testResults: '**/target/surefire-reports/*.xml', allowEmptyResults: true
            junit testResults: '**/target/failsafe-reports/*.xml', allowEmptyResults: true
            cleanWs()
        }
        success {
            echo "CI completed successfully."
        }
        failure {
            echo 'CI pipeline failed.'
        }
    }
}