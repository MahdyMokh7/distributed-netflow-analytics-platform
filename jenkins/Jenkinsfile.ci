pipeline {
    agent {
        docker {
            label 'nimbo-nimbyte'
            image 'maven:3.9-eclipse-temurin-17'

            args '''
                --network host
                --add-host sonarqube.inside.sahab.ir:192.168.12.53
                --add-host host.docker.internal:host-gateway
                -v /var/run/docker.sock:/var/run/docker.sock
                --group-add 999
                -v /home/team1/.m2:/home/team1/.m2
                -v /opt/jdk-17.0.6/lib/security/cacerts:/certs/cacerts:ro
                -v /etc/passwd:/etc/passwd:ro
                -v /etc/group:/etc/group:ro
            '''
        }
    }

    options {
        timestamps()
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        SPRING_PROFILES_ACTIVE = 'prod'
        MAVEN_OPTS = '-Djavax.net.ssl.trustStore=/certs/cacerts'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                sh '''
                    mvn \
                      --settings jenkins/maven-settings.xml \
                      --batch-mode \
                      --no-transfer-progress \
                      clean verify \
                '''
            }
        }

        stage('Run Sonar Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh 'bash jenkins/scripts/ci/sonar-analysis.sh'
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {
        always {
            junit testResults: '**/target/surefire-reports/*.xml', allowEmptyResults: true
            junit testResults: '**/target/failsafe-reports/*.xml', allowEmptyResults: true
            cleanWs()
        }
        success {
            echo "CI completed successfully."
        }
        failure {
            echo 'CI pipeline failed.'
        }
    }
}
