pipeline {
    agent {
        docker {
            label 'nimbo-nimbyte'
            image 'maven:3.9-eclipse-temurin-17'
            args '''
                --network host
                --add-host sonarqube.inside.sahab.ir:192.168.12.53
                -v /home/team1/.m2:/home/team1/.m2
                -v /home/team1/.m2/settings.xml:/usr/share/maven/conf/settings.xml:ro
                -v /opt/jdk-17.0.6/lib/security/cacerts:/certs/cacerts:ro
                -v /etc/passwd:/etc/passwd:ro
                -v /etc/group:/etc/group:ro
            '''
        }
    }

    options {
        timestamps()
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        SPRING_PROFILES_ACTIVE = 'prod'
        MAVEN_OPTS = '-Djavax.net.ssl.trustStore=/certs/cacerts -Djavax.net.ssl.trustStorePassword=changeit'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                sh 'mvn -B clean verify -DskipITs'
            }
        }

        stage('Run Sonar Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''
                        set -eu
                        mkdir -p /tmp/sonar-cache

                        BRANCH="${GERRIT_BRANCH:-master}"
                        CHANGE="${GERRIT_CHANGE_NUMBER:-manual-build}"
                        PATCHSET="${GERRIT_PATCHSET_NUMBER:-0}"

                        mvn \
                          --batch-mode \
                          --no-transfer-progress \
                          org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                          -Dsonar.projectKey=nimbo-nimbyte \
                          -Dsonar.host.url="${SONAR_HOST_URL}" \
                          -Dsonar.login="${SONAR_AUTH_TOKEN}" \
                          -Dsonar.userHome=/tmp/sonar-cache \
                          -Dsonar.pullrequest.base="${BRANCH}" \
                          -Dsonar.pullrequest.key="${CHANGE}" \
                          -Dsonar.pullrequest.branch="change-${CHANGE}-${PATCHSET}" \
                          -Dsonar.analysis.gerritId="${CHANGE}-${PATCHSET}"
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {
        always {
            junit testResults: '**/target/surefire-reports/*.xml', allowEmptyResults: true
            junit testResults: '**/target/failsafe-reports/*.xml', allowEmptyResults: true
            archiveArtifacts artifacts: '**/target/*.jar', fingerprint: true, allowEmptyArchive: true
            cleanWs()
        }
        success {
            echo "CI completed successfully. JAR artifacts stashed and archived for CD."
        }
        failure {
            echo 'CI pipeline failed quality gate or test stages.'
        }
    }
}