
stage('Build Docker Image') {
    when {
        expression { params.DEPLOY_ACTION == 'deploy' }
    }
    steps {
        sh """
                    docker build -t ${IMAGE_NAME}:latest -t ${IMAGE_NAME}:${IMAGE_TAG} .
                """
    }
}

stage('Deploy') {
    when {
        expression { params.DEPLOY_ACTION == 'deploy' }
    }
    steps {
        script {
            def kafkaServers = params.KAFKA_OVERRIDE ?: env.KAFKA_BOOTSTRAP_SERVERS
            def hdfsUri = params.HDFS_OVERRIDE ?: env.HDFS_URI

            sh 'docker stop nimbo-ingester 2>/dev/null || true'
            sh 'docker rm nimbo-ingester 2>/dev/null || true'

            sh """
                        docker run -d \
                            --name nimbo-ingester \
                            --restart unless-stopped \
                            -e SPRING_PROFILES_ACTIVE=prod \
                            -p 8080:8080 \
                            ${IMAGE_NAME}:latest
                    """

            sh 'sleep 10'

            def deploy = sh(
                    script: 'curl -s http://localhost:8080/actuator/health',
                    returnStatus: true
            )

            if (deploy != 0) {
                error 'Deployment failed: Health check failed'
            }

            echo '✅ Deployment successful!'
        }
    }
}

pipeline {
    agent {
        label 'team-nimbyte'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout()
        skipDefaultCheckout(true)
        buildDiscarder(
                logRotator(
                        numToKeepStr: '20',
                        artifactNumToKeepStr: '10'
                )
        )
        timeout(time: 15, unit: 'MINUTES')
    }

    parameters {
        string(
                name: 'RELEASE_TAG',
                defaultValue: '',
                description: 'Tag/Build Number to deploy (e.g., 42). Defaults to current BUILD_NUMBER if left empty.'
        )
    }

    environment {
        MAVEN_OPTS = '-Xmx1024m'

        IMAGE_NAME = 'nimbo-nimbyte'
        CONTAINER_NAME = 'nimbo-nimbyte'
        IMAGE_TAG = "${params.RELEASE_TAG ?: env.BUILD_NUMBER}"
        SPRING_PROFILES_ACTIVE = 'prod'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Image') {
            steps {
                sh '''
                    mvn -B compile \
                        jib:dockerBuild \
                        -Djib.image.tag="${IMAGE_TAG}"
                '''
            }
        }

        stage('Verify Image') {
            steps {
                sh '''
                    docker image inspect \
                        "${IMAGE_NAME}:${IMAGE_TAG}" \
                        >/dev/null
                '''
            }
        }

//        stage('Ensure DLQ Topic') {
//            steps {
//                sh '''
//                    /opt/kafka/bin/kafka-topics.sh \
//                        --bootstrap-server "${KAFKA_BOOTSTRAP_SERVERS}" \
//                        --create \
//                        --if-not-exists \
//                        --topic "${KAFKA_DLQ_TOPIC}" \
//                        --partitions "${KAFKA_DLQ_PARTITIONS}" \
//                        --replication-factor "${KAFKA_DLQ_REPLICATION_FACTOR}"
//                '''
//            }
//        }

        stage('Deploy') {
            steps {
                sh '''
                    docker rm -f ${CONTAINER_NAME} 2>/dev/null || true

                    docker run -d \
                        --name ${CONTAINER_NAME} \
                        --restart unless-stopped \
                        -e SPRING_PROFILES_ACTIVE="${SPRING_PROFILES_ACTIVE}" \
                        -p 8080:8080 \
                        "${IMAGE_NAME}:${IMAGE_TAG}"
                '''
            }
        }

        stage('Health Check') {
            steps {
                script {
                    timeout(time: 2, unit: 'MINUTES') {
                        waitUntil {
                            def result = sh(
                                    script: '''
                                    curl -fsS \
                                        http://localhost:8080/actuator/health \
                                        >/dev/null
                                ''',
                                    returnStatus: true
                            )

                            if (result == 0) {
                                return true
                            }
                            sleep 5
                            return false
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Release deployed successfully: container ${CONTAINER_NAME} with image ${IMAGE_NAME}:${IMAGE_TAG}."
        }

        failure {
            echo 'Release pipeline failed for ${IMAGE_NAME}:${IMAGE_TAG}.'
        }
    }
}