def deployModule(moduleName, host, user, pass, port) {
    withEnv([
            "MODULE_HOST=${host}",
            "MODULE_USER=${user}",
            "MODULE_PASS=${pass}",
            "MODULE_PORT=${port}",
            "MODULE_NAME=${moduleName}"
    ]) {
        sh '''
            set -eu
            export SSHPASS="${MODULE_PASS}"
            echo "Deploying ${MODULE_NAME} to ${MODULE_HOST}:${MODULE_PORT}..."

            sshpass -e ssh \
              -o StrictHostKeyChecking=no \
              "${MODULE_USER}@${MODULE_HOST}" \
              "
                set -e

                printf '%s\\n' '${NEXUS_PASSWORD}' | \
                  docker login '${NEXUS_PULL_REGISTRY}' \
                    --username '${NEXUS_USERNAME}' \
                    --password-stdin

                docker pull \
                  ${NEXUS_PULL_REGISTRY}/${IMAGE_PREFIX}-${MODULE_NAME}:${IMAGE_TAG}

                echo 'Stopping existing ${MODULE_NAME} container...'
                docker stop --timeout 30 ${MODULE_NAME} 2>/dev/null || true
                docker rm ${MODULE_NAME} 2>/dev/null || true

                docker run -d \
                  --name ${MODULE_NAME} \
                  --network host \
                  --restart unless-stopped \
                  --stop-timeout 30 \
                  -e SPRING_PROFILES_ACTIVE=${SPRING_PROFILES_ACTIVE} \
                  -e SERVER_PORT=${MODULE_PORT} \
                  ${NEXUS_PULL_REGISTRY}/${IMAGE_PREFIX}-${MODULE_NAME}:${IMAGE_TAG}
              "
        '''
    }
}

def healthCheck(moduleName, host, user, pass, port) {
    withEnv([
            "MODULE_HOST=${host}",
            "MODULE_USER=${user}",
            "MODULE_PASS=${pass}",
            "MODULE_PORT=${port}",
            "MODULE_NAME=${moduleName}"
    ]) {
        sh '''
            set -eu
            export SSHPASS="${MODULE_PASS}"
            echo "Checking ${MODULE_NAME} on ${MODULE_HOST}:${MODULE_PORT}..."
            sshpass -e ssh \
                -o StrictHostKeyChecking=no \
                "${MODULE_USER}@${MODULE_HOST}" \
                "
                    for i in \\$(seq 1 60); do
                        if curl -fsS http://localhost:${MODULE_PORT}/actuator/health >/dev/null; then
                            echo '${MODULE_NAME} is healthy'
                            exit 0
                        fi
                        sleep 2
                    done
                    echo '${MODULE_NAME} health check failed'
                    docker logs --tail 100 ${MODULE_NAME} || true
                    exit 1
                "
        '''
    }
}


def deployLocal(moduleName, port) {
    withEnv([
            "MODULE_PORT=${port}",
            "MODULE_NAME=${moduleName}"
    ]) {
        sh '''
            set -eu
            echo "Deploying ${MODULE_NAME} locally on this agent, port ${MODULE_PORT}..."

            printf '%s\\n' "${NEXUS_PASSWORD}" | \
              docker login "${NEXUS_PULL_REGISTRY}" \
                --username "${NEXUS_USERNAME}" \
                --password-stdin

            docker pull \
              ${NEXUS_PULL_REGISTRY}/${IMAGE_PREFIX}-${MODULE_NAME}:${IMAGE_TAG}

            echo "Stopping existing ${MODULE_NAME} container..."
            docker stop --timeout 30 ${MODULE_NAME} 2>/dev/null || true
            docker rm ${MODULE_NAME} 2>/dev/null || true

            docker run -d \
              --name ${MODULE_NAME} \
              --network host \
              --restart unless-stopped \
              --stop-timeout 30 \
              -e SPRING_PROFILES_ACTIVE=${SPRING_PROFILES_ACTIVE} \
              -e SERVER_PORT=${MODULE_PORT} \
              ${NEXUS_PULL_REGISTRY}/${IMAGE_PREFIX}-${MODULE_NAME}:${IMAGE_TAG}
        '''
    }
}

def healthCheckLocal(moduleName, port, contextPath = '') {
    withEnv([
            "MODULE_PORT=${port}",
            "MODULE_NAME=${moduleName}",
            "CONTEXT_PATH=${contextPath}"
    ]) {
        sh '''
            set -eu
            echo "Checking ${MODULE_NAME} locally on port ${MODULE_PORT}${CONTEXT_PATH}..."

            for i in $(seq 1 60); do
                if curl -fsS http://localhost:${MODULE_PORT}${CONTEXT_PATH}/actuator/health >/dev/null; then
                    echo "${MODULE_NAME} is healthy"
                    exit 0
                fi
                sleep 2
            done

            echo "${MODULE_NAME} health check failed"
            docker logs --tail 100 ${MODULE_NAME} || true
            exit 1
        '''
    }
}

pipeline {

    agent none

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
        timeout(time: 15, unit: 'MINUTES')
    }

    parameters {

        string(name: 'RELEASE_TAG', defaultValue: '', description: 'Image tag. Empty = Jenkins BUILD_NUMBER.')

        string(name: 'NEXUS_HOST', defaultValue: 'zoraq.inside.sahab.ir', description: 'Nexus host/IP')
        string(name: 'NEXUS_GROUP_PORT', defaultValue: '9462', description: 'Docker group port used for pulls')
        string(name: 'NEXUS_HOSTED_PORT', defaultValue: '9466', description: 'Docker hosted port used for pushes')
        string(name: 'NEXUS_USERNAME', defaultValue: 'nimbo1', description: 'Nexus username')
        password(name: 'NEXUS_PASSWORD', defaultValue: 'gvFUU0Fxma95w9', description: 'Nexus password')

        string(name: 'MODULE1_HOST', defaultValue: '10.10.61.52', description: 'batch-ingester server IP')
        string(name: 'MODULE1_USER', defaultValue: 'team1', description: 'SSH user for batch-ingester server')
        password(name: 'MODULE1_PASSWORD', defaultValue: 'team1', description: 'SSH password for batch-ingester')
        string(name: 'MODULE1_PORT', defaultValue: '18080', description: 'Host port for batch-ingester')

        string(name: 'MODULE2_HOST', defaultValue: '10.10.61.53', description: 'batch-processor server IP')
        string(name: 'MODULE2_USER', defaultValue: 'team1', description: 'SSH user for batch-processor server')
        password(name: 'MODULE2_PASSWORD', defaultValue: 'team1', description: 'SSH password for batch-processor')
        string(name: 'MODULE2_PORT', defaultValue: '18081', description: 'Host port for batch-processor')

        string(name: 'MODULE3_HOST', defaultValue: '10.10.61.54', description: 'realtime-service server IP')
        string(name: 'MODULE3_USER', defaultValue: 'team1', description: 'SSH user for realtime-service server')
        password(name: 'MODULE3_PASSWORD', defaultValue: 'team1', description: 'SSH password for realtime-service')
        string(name: 'MODULE3_PORT', defaultValue: '18082', description: 'Host port for realtime-service')

        string(name: 'REST_API_PORT', defaultValue: '18083', description: 'Host port for rest-api (runs on the Jenkins agent itself)')
    }

    environment {
        IMAGE_TAG = "${params.RELEASE_TAG ?: env.BUILD_NUMBER}"
        NEXUS_PUSH_REGISTRY = "${params.NEXUS_HOST}:${params.NEXUS_HOSTED_PORT}"
        NEXUS_PULL_REGISTRY = "${params.NEXUS_HOST}:${params.NEXUS_GROUP_PORT}"
        IMAGE_PREFIX = 'nimbo-nimbyte'
        SPRING_PROFILES_ACTIVE = 'prod'
        MAVEN_OPTS = '''
            -Xmx1024m
            -Djavax.net.ssl.trustStore=/certs/cacerts
        '''
    }

    stages {

        stage('Master Sonar Analysis') {
            agent {
                docker {
                    label 'nimbo-nimbyte'
                    image 'maven:3.9-eclipse-temurin-17'
                    args '''
                        --network host
                        --add-host sonarqube.inside.sahab.ir:192.168.12.53
                        -v /var/run/docker.sock:/var/run/docker.sock
                        --group-add 999
                        -v /home/team1/.m2:/home/team1/.m2
                        -v /opt/jdk-17.0.6/lib/security/cacerts:/certs/cacerts:ro
                        -v /etc/passwd:/etc/passwd:ro
                        -v /etc/group:/etc/group:ro
                    '''
                }
            }
            steps {
                checkout scm

                withSonarQubeEnv('sonarqube') {
                    sh '''
                        set -eu
                        mkdir -p /tmp/sonar

                        mvn \
                          --settings jenkins/maven-settings.xml \
                          --batch-mode \
                          --no-transfer-progress \
                          clean verify \

                        echo "===== JaCoCo reports ====="
                        find . -name "jacoco.xml" -print

                        mvn \
                          --settings jenkins/maven-settings.xml \
                          --batch-mode \
                          --no-transfer-progress \
                          org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                          -Dsonar.projectKey=nimbo-nimbyte \
                          -Dsonar.projectName=nimbo-nimbyte \
                          -Dsonar.branch.name=master \
                          -Dsonar.host.url="${SONAR_HOST_URL}" \
                          -Dsonar.login="${SONAR_AUTH_TOKEN}" \
                          -Dsonar.userHome=/tmp/sonar \
                          -Dsonar.coverage.jacoco.xmlReportPaths="**/target/site/jacoco/jacoco.xml"
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: false
                }
            }
        }

        stage('Build & Push Images') {
            agent {
                docker {
                    label 'nimbo-nimbyte'
                    image 'maven:3.9-eclipse-temurin-17'
                    args '''
                        --network host
                        -v /opt/jdk-17.0.6/lib/security/cacerts:/certs/cacerts:ro
                        -v /etc/passwd:/etc/passwd:ro
                        -v /etc/group:/etc/group:ro
                        -v /home/team1/.m2:/home/team1/.m2
                    '''
                }
            }

            steps {
                checkout scm

                sh '''
                    set -eu
                    set +x

                    export XDG_CONFIG_HOME="${WORKSPACE}/.config"
                    export XDG_CACHE_HOME="${WORKSPACE}/.cache"
                    mkdir -p "${XDG_CONFIG_HOME}" "${XDG_CACHE_HOME}"

                    echo "Building release: ${IMAGE_TAG}"
                    echo "Pushing images to: ${NEXUS_PUSH_REGISTRY}"

                    mvn \
                      --settings jenkins/maven-settings.xml \
                      --batch-mode \
                      --no-transfer-progress \
                      clean compile jib:build \
                      -DskipTests \
                      -Djib.allowInsecureRegistries=true \
                      -Djib.image.tag="${IMAGE_TAG}" \
                      -Djib.from.auth.username="${NEXUS_USERNAME}" \
                      -Djib.from.auth.password="${NEXUS_PASSWORD}" \
                      -Djib.to.auth.username="${NEXUS_USERNAME}" \
                      -Djib.to.auth.password="${NEXUS_PASSWORD}" \
                      -Djib.applicationCache="${XDG_CACHE_HOME}/jib-application" \
                      -Djib.baseImageCache="${XDG_CACHE_HOME}/jib-base-image"
                '''
            }
        }

        stage('Deploy to Target Servers') {
            agent {
                label 'nimbo-nimbyte'
            }
            steps {
                script {
                    parallel(
                            'Deploy batch-ingester': {
                                deployModule('batch-ingester', params.MODULE1_HOST, params.MODULE1_USER,
                                        params.MODULE1_PASSWORD, params.MODULE1_PORT)
                            },
                            'Deploy batch-processor': {
                                deployModule('batch-processor', params.MODULE2_HOST, params.MODULE2_USER,
                                        params.MODULE2_PASSWORD, params.MODULE2_PORT)
                            },
                            'Deploy realtime-service': {
                                deployModule('realtime', params.MODULE3_HOST, params.MODULE3_USER,
                                        params.MODULE3_PASSWORD, params.MODULE3_PORT)
                            },
                            'Deploy rest-api': {
                                deployLocal('rest-api', params.REST_API_PORT)
                            }
                    )
                }
            }
        }

        stage('Health Check') {
            agent { label 'nimbo-nimbyte' }
            steps {
                script {
                    parallel(
                            'batch-ingester health': {
                                healthCheck('batch-ingester', params.MODULE1_HOST, params.MODULE1_USER,
                                        params.MODULE1_PASSWORD, params.MODULE1_PORT)
                            },
                            'batch-processor health': {
                                healthCheck('batch-processor', params.MODULE2_HOST, params.MODULE2_USER,
                                        params.MODULE2_PASSWORD, params.MODULE2_PORT)
                            },
                            'realtime-service health': {
                                healthCheck('realtime', params.MODULE3_HOST, params.MODULE3_USER,
                                        params.MODULE3_PASSWORD, params.MODULE3_PORT)
                            },
                            'rest-api health': {
                                healthCheckLocal('rest-api', params.REST_API_PORT, '/api')
                            }
                    )
                }
            }
        }
    }

    post {
        success {
            echo "Release deployed successfully : ${IMAGE_TAG}."
        }
        failure {
            echo "Release pipeline failed for : ${IMAGE_TAG}."
        }
    }
}