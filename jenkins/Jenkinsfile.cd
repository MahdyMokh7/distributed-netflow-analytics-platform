def helmDeploy(moduleName) {
    withEnv(["MODULE_NAME=${moduleName}"]) {
        sh '''
            set -eu
            echo "Deploying ${MODULE_NAME} via Helm..."

            helm upgrade --install "${MODULE_NAME}" "charts/${MODULE_NAME}" \
              --namespace "${KUBE_NAMESPACE}" \
              --set image.repository="${NEXUS_PULL_REGISTRY}/${IMAGE_PREFIX}-${MODULE_NAME}" \
              --set image.tag="${IMAGE_TAG}" \
              --wait \
              --timeout 5m
        '''
    }
}

pipeline {

    agent none

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
        timeout(time: 15, unit: 'MINUTES')
    }

    parameters {

        string(name: 'RELEASE_TAG', defaultValue: '', description: 'Image tag. Empty = Jenkins BUILD_NUMBER.')

        string(name: 'NEXUS_HOST', defaultValue: 'zoraq.inside.sahab.ir', description: 'Nexus host/IP')
        string(name: 'NEXUS_GROUP_PORT', defaultValue: '9462', description: 'Docker group port used for pulls')
        string(name: 'NEXUS_HOSTED_PORT', defaultValue: '9466', description: 'Docker hosted port used for pushes')
        string(name: 'NEXUS_USERNAME', defaultValue: 'nimbo1', description: 'Nexus username')
        password(name: 'NEXUS_PASSWORD', defaultValue: 'gvFUU0Fxma95w9', description: 'Nexus password')

        string(name: 'KUBE_NAMESPACE', defaultValue: 'team1', description: 'Kubernetes namespace to deploy into')
    }

    environment {
        IMAGE_TAG = "${params.RELEASE_TAG ?: env.BUILD_NUMBER}"
        NEXUS_PUSH_REGISTRY = "${params.NEXUS_HOST}:${params.NEXUS_HOSTED_PORT}"
        NEXUS_PULL_REGISTRY = "${params.NEXUS_HOST}:${params.NEXUS_GROUP_PORT}"
        IMAGE_PREFIX = 'nimbo-nimbyte'
        SPRING_PROFILES_ACTIVE = 'prod'
        KUBE_NAMESPACE = "${params.KUBE_NAMESPACE}"
        MAVEN_OPTS = '''
            -Xmx1024m
            -Djavax.net.ssl.trustStore=/certs/cacerts
        '''
    }

    stages {

        stage('Master Sonar Analysis') {
            agent {
                docker {
                    label 'nimbo-nimbyte'
                    image 'maven:3.9-eclipse-temurin-17'
                    args '''
                        --network host
                        --add-host sonarqube.inside.sahab.ir:192.168.12.53
                        -v /var/run/docker.sock:/var/run/docker.sock
                        --group-add 999
                        -v /home/team1/.m2:/home/team1/.m2
                        -v /opt/jdk-17.0.6/lib/security/cacerts:/certs/cacerts:ro
                        -v /etc/passwd:/etc/passwd:ro
                        -v /etc/group:/etc/group:ro
                    '''
                }
            }
            steps {
                checkout scm

                withSonarQubeEnv('sonarqube') {
                    sh '''
                        set -eu
                        mkdir -p /tmp/sonar

                        mvn \
                          --settings jenkins/maven-settings.xml \
                          --batch-mode \
                          --no-transfer-progress \
                          clean verify \

                        echo "===== JaCoCo reports ====="
                        find . -name "jacoco.xml" -print

                        mvn \
                          --settings jenkins/maven-settings.xml \
                          --batch-mode \
                          --no-transfer-progress \
                          org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                          -Dsonar.projectKey=nimbo-nimbyte \
                          -Dsonar.projectName=nimbo-nimbyte \
                          -Dsonar.branch.name=master \
                          -Dsonar.host.url="${SONAR_HOST_URL}" \
                          -Dsonar.login="${SONAR_AUTH_TOKEN}" \
                          -Dsonar.userHome=/tmp/sonar \
                          -Dsonar.coverage.jacoco.xmlReportPaths="**/target/site/jacoco/jacoco.xml"
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: false
                }
            }
        }

        stage('Build & Push Images') {
            agent {
                docker {
                    label 'nimbo-nimbyte'
                    image 'maven:3.9-eclipse-temurin-17'
                    args '''
                        --network host
                        -v /opt/jdk-17.0.6/lib/security/cacerts:/certs/cacerts:ro
                        -v /etc/passwd:/etc/passwd:ro
                        -v /etc/group:/etc/group:ro
                        -v /home/team1/.m2:/home/team1/.m2
                    '''
                }
            }

            steps {
                checkout scm

                sh '''
                    set -eu
                    set +x

                    export XDG_CONFIG_HOME="${WORKSPACE}/.config"
                    export XDG_CACHE_HOME="${WORKSPACE}/.cache"
                    mkdir -p "${XDG_CONFIG_HOME}" "${XDG_CACHE_HOME}"

                    echo "Building release: ${IMAGE_TAG}"
                    echo "Pushing images to: ${NEXUS_PUSH_REGISTRY}"

                    mvn \
                      --settings jenkins/maven-settings.xml \
                      --batch-mode \
                      --no-transfer-progress \
                      clean package \
                      -DskipTests

                    SPARK_JAR_COUNT="$(find batch-processor/target -maxdepth 1 -type f -name 'batch-processor-*-spark.jar' | wc -l)"
                    test "${SPARK_JAR_COUNT}" -eq 1
                    test -s "$(find batch-processor/target -maxdepth 1 -type f -name 'batch-processor-*-spark.jar')"

                    mvn \
                      --settings jenkins/maven-settings.xml \
                      --batch-mode \
                      --no-transfer-progress \
                      jib:build \
                      -DskipTests \
                      -Djib.allowInsecureRegistries=true \
                      -Djib.image.tag="${IMAGE_TAG}" \
                      -Djib.from.auth.username="${NEXUS_USERNAME}" \
                      -Djib.from.auth.password="${NEXUS_PASSWORD}" \
                      -Djib.to.auth.username="${NEXUS_USERNAME}" \
                      -Djib.to.auth.password="${NEXUS_PASSWORD}" \
                      -Djib.applicationCache="${XDG_CACHE_HOME}/jib-application" \
                      -Djib.baseImageCache="${XDG_CACHE_HOME}/jib-base-image"
                '''
            }
        }

        stage('Deploy to Kubernetes') {

            agent {
                label 'nimbo-nimbyte'
            }

            steps {
                checkout scm
                script {
                    sh 'kubectl config current-context'

                    parallel(
                            'Deploy batch-ingester': { helmDeploy('batch-ingester') },
                            'Deploy batch-processor': { helmDeploy('batch-processor') },
                            'Deploy realtime': { helmDeploy('realtime') },
                            'Deploy rest-api': { helmDeploy('rest-api') }
                    )
                }
            }
        }
    }

    post {
        success {
            echo "Release deployed successfully : ${IMAGE_TAG}."
        }
        failure {
            echo "Release pipeline failed for : ${IMAGE_TAG}."
        }
    }
}
