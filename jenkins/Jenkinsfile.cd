static def stateDir() {
    return '/home/team1/.nimbo-cd-state'
}

def lastSha(String component) {
    def path = "${stateDir()}/${component}"
    def exists = sh(script: "test -f '${path}'", returnStatus: true) == 0
    if (!exists) { return null }
    return sh(script: "cat '${path}'", returnStdout: true).trim()
}

def changed(String component, String pathPrefixes) {
    if (params.FORCE_ALL) { return true }
    def sha = lastSha(component)
    if (sha == null) { return true }
    def diff = sh(script: "git diff --name-only ${sha}..HEAD -- ${pathPrefixes}", returnStdout: true).trim()
    return diff.length() > 0
}

def headShortSha() {
    return sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim()
}

def recordState(String component, String sha) {
    sh """
        mkdir -p '${stateDir()}'
        echo '${sha}' > '${stateDir()}/${component}'
    """
}

static def modulePathPrefixes(String name) {
    return "${name}/ charts/${name}/"
}

static def moduleNames() {
    return ['parquet-writer', 'cube-maker', 'starrocks-writer', 'rest-api', 'analytics-query']
}

def userSelectedModules() {
    def moduleMap = [
            'parquet-writer'  : params.DEPLOY_PARQUET_WRITER,
            'cube-maker' : params.DEPLOY_CUBE_MAKER,
            'starrocks-writer': params.DEPLOY_STARROCKS_WRITER,
            'rest-api'        : params.DEPLOY_REST_API,
            'analytics-query' : params.DEPLOY_ANALYTICS_QUERY
    ]
    def selected = moduleMap.findAll { name, isSelected -> isSelected }.keySet() as List
    if (selected.isEmpty()) {
        error("No modules selected. Tick at least one.")
    }
    return selected
}

def computeModulesToDeploy() {
    def userSelected = userSelectedModules()
    def toDeploy = userSelected.findAll { name -> changed(name, modulePathPrefixes(name)) }

    def skipped = userSelected - toDeploy
    if (skipped) {
        echo "Skipping unchanged modules (no build, no push, no deploy): ${skipped.join(', ')}"
    }
    echo toDeploy.isEmpty()
            ? "Selected modules (${userSelected.join(', ')}) are unchanged - nothing to build or deploy this run."
            : "Will build, push, and deploy: ${toDeploy.join(', ')}"

    env.MODULES_TO_DEPLOY = toDeploy.join(',')
}

def modulesToDeployList() {
    return env.MODULES_TO_DEPLOY ? env.MODULES_TO_DEPLOY.split(',') as List : []
}

def buildHelmArgs(List toDeploy) {
    def allModules = toDeploy.size() == moduleNames().size()

    def releaseExists = sh(
            script: "helm status nimbo-platform --namespace \"${env.KUBE_NAMESPACE}\" > /dev/null 2>&1",
            returnStatus: true
    ) == 0

    if (!allModules && !releaseExists) {
        echo "WARNING: partial deploy (${toDeploy.join(', ')}) but no existing nimbo-platform release was found. " +
                "The untouched modules will be created for the first time using their chart defaults (image.tag=latest)."
    }

    def setArgs = toDeploy.collect { name ->
        "--set ${name}.image.repository=${env.NEXUS_PULL_REGISTRY}/${env.IMAGE_PREFIX}-${name} --set ${name}.image.tag=${env.IMAGE_TAG}"
    }.join(' ')

    def reuseFlag = (!allModules && releaseExists) ? '--reuse-values' : ''

    return "${reuseFlag} ${setArgs}".trim()
}

pipeline {

    agent none

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        string(name: 'RELEASE_TAG', defaultValue: '', description: 'Image tag. Empty = Jenkins BUILD_NUMBER.')

        string(name: 'NEXUS_HOST', defaultValue: 'zoraq.inside.sahab.ir', description: 'Nexus host/IP')
        string(name: 'NEXUS_GROUP_PORT', defaultValue: '9462', description: 'Docker group port used for pulls')
        string(name: 'NEXUS_HOSTED_PORT', defaultValue: '9466', description: 'Docker hosted port used for pushes')
        string(name: 'NEXUS_USERNAME', defaultValue: 'nimbo1', description: 'Nexus username')
        password(name: 'NEXUS_PASSWORD', defaultValue: '', description: 'Nexus password')

        string(name: 'KUBE_NAMESPACE', defaultValue: 'team1', description: 'Kubernetes namespace to deploy into')

        booleanParam(name: 'RUN_SONAR', defaultValue: false, description: 'Run Sonar analysis and quality gate before build')
        booleanParam(name: 'FORCE_ALL', defaultValue: false, description: 'Build+deploy all checked modules even if unchanged since last successful deploy')

        booleanParam(name: 'DEPLOY_PARQUET_WRITER', defaultValue: true, description: 'Include parquet-writer in this run')
        booleanParam(name: 'DEPLOY_CUBE_MAKER', defaultValue: true, description: 'Include cube-maker in this run')
        booleanParam(name: 'DEPLOY_STARROCKS_WRITER', defaultValue: true, description: 'Include starrocks-writer in this run')
        booleanParam(name: 'DEPLOY_REST_API', defaultValue: true, description: 'Include rest-api in this run')
        booleanParam(name: 'DEPLOY_ANALYTICS_QUERY', defaultValue: true, description: 'Include analytics-query in this run')
    }

    environment {
        IMAGE_TAG = "${params.RELEASE_TAG ?: env.BUILD_NUMBER}"
        NEXUS_PUSH_REGISTRY = "${params.NEXUS_HOST}:${params.NEXUS_HOSTED_PORT}"
        NEXUS_PULL_REGISTRY = "${params.NEXUS_HOST}:${params.NEXUS_GROUP_PORT}"
        IMAGE_PREFIX = 'nimbo-nimbyte'
        SPRING_PROFILES_ACTIVE = 'prod'
        KUBE_NAMESPACE = "${params.KUBE_NAMESPACE}"
        UMBRELLA_CHART = 'charts/nimbo-platform'
        MAVEN_OPTS = '''
            -Xmx1024m
            -Djavax.net.ssl.trustStore=/certs/cacerts
        '''
    }

    stages {

        stage('Master Sonar Analysis') {
            when { expression { return params.RUN_SONAR } }
            agent {
                docker {
                    label 'nimbo-nimbyte'
                    image 'maven:3.9-eclipse-temurin-17'
                    args '''
                        --network host
                        --add-host sonarqube.inside.sahab.ir:192.168.12.53
                        -v /var/run/docker.sock:/var/run/docker.sock
                        --group-add 999
                        -v /home/team1/.m2:/home/team1/.m2
                        -v /opt/jdk-17.0.6/lib/security/cacerts:/certs/cacerts:ro
                        -v /etc/passwd:/etc/passwd:ro
                        -v /etc/group:/etc/group:ro
                    '''
                }
            }
            steps {
                checkout scm
                withSonarQubeEnv('sonarqube') {
                    sh 'bash jenkins/scripts/cd/sonar-analysis.sh'
                }
            }
        }

        stage('Quality Gate') {
            when { expression { return params.RUN_SONAR } }
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: false
                }
            }
        }

        stage('Compute Deploy Plan') {
            agent { label 'nimbo-nimbyte' }
            steps {
                checkout scm
                script { computeModulesToDeploy() }
            }
        }

        stage('Build & Push Images') {
            when { expression { return env.MODULES_TO_DEPLOY?.trim() } }
            agent {
                docker {
                    label 'nimbo-nimbyte'
                    image 'maven:3.9-eclipse-temurin-17'
                    customWorkspace '/mnt/disk1/jenkins-agent/nimbo-nimbyte-release-build'
                    args '''
                        --network host
                        -v /opt/jdk-17.0.6/lib/security/cacerts:/certs/cacerts:ro
                        -v /etc/passwd:/etc/passwd:ro
                        -v /etc/group:/etc/group:ro
                        -v /home/team1/.m2:/home/team1/.m2
                    '''
                }
            }
            steps {
                checkout scm
                script {
                    def modules = modulesToDeployList()
                    withEnv([
                            "MODULES_CSV=${modules.join(',')}",
                            "BUILDS_CUBE_MAKER=${modules.contains('cube-maker')}"
                    ]) {
                        sh 'bash jenkins/scripts/cd/build-and-push.sh'
                    }
                }
            }
        }

        stage('Resolve Umbrella Chart') {
            when { expression { return env.MODULES_TO_DEPLOY?.trim() } }
            agent { label 'nimbo-nimbyte' }
            steps {
                checkout scm
                sh '''
                    set -eu
                    rm -rf "${UMBRELLA_CHART}/charts" "${UMBRELLA_CHART}/Chart.lock"
                    helm dependency update "${UMBRELLA_CHART}"
                '''
            }
        }

        stage('Validate Deploy (dry-run)') {
            when { expression { return env.MODULES_TO_DEPLOY?.trim() } }
            agent { label 'nimbo-nimbyte' }
            steps {
                checkout scm
                script {
                    def deployArgs = buildHelmArgs(modulesToDeployList())
                    withEnv(["DEPLOY_ARGS=${deployArgs}"]) {
                        sh 'bash jenkins/scripts/cd/helm-deploy.sh dry-run'
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            when { expression { return env.MODULES_TO_DEPLOY?.trim() } }
            agent { label 'nimbo-nimbyte' }
            steps {
                checkout scm
                script {
                    sh 'kubectl config current-context'
                    def deployArgs = buildHelmArgs(modulesToDeployList())
                    withEnv(["DEPLOY_ARGS=${deployArgs}"]) {
                        sh 'bash jenkins/scripts/cd/helm-deploy.sh apply'
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                if (env.MODULES_TO_DEPLOY?.trim()) {
                    def sha = headShortSha()
                    modulesToDeployList().each { name -> recordState(name, sha) }
                }
            }
            echo "Release pipeline finished successfully."
        }
        failure {
            echo "Release pipeline failed."
        }
    }
}
