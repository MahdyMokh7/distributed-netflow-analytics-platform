# Nimbo Data Ingester - Environment Variables
# Copy this file to .env and customize for your local environment

# Spring Profile (dev | prod | test)
SPRING_PROFILES_ACTIVE=dev

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=netflow
KAFKA_CONSUMER_GROUP=parquet-writer

# HDFS Configuration
HDFS_URI=hdfs://namenode:9000
HDFS_BASE_PATH=/data/netflow/
HDFS_REPLICATION_FACTOR=1

# Parquet Configuration
PARQUET_COMPRESSION=SNAPPY

# File Rolling Strategy
ROLLING_STRATEGY=TIME_AND_SIZE
ROLLING_TIME_INTERVAL=5
ROLLING_MAX_SIZE_MB=100

# Logging Level
LOGGING_LEVEL_COM_NIMBO_INGESTER=DEBUG

# JVM Options
JAVA_OPTS=-Xmx512m -Xms256m
