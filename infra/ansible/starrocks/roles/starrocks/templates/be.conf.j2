# Managed by Ansible. Shared-nothing StarRocks {{ starrocks_version }}.
JAVA_HOME = {{ starrocks_java_home }}
JAVA_OPTS="-Xmx512m --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/sun.nio.ch=ALL-UNNAMED -Duser.timezone=UTC"
LOG_DIR = {{ starrocks_log_dir }}/be
PID_DIR = /run/starrocks-be
storage_root_path = {{ starrocks_storage_dir }}
priority_networks = {{ starrocks_address }}/32
be_http_port = {{ starrocks_be_http_port }}
be_port = {{ starrocks_be_port }}
heartbeat_service_port = {{ starrocks_heartbeat_port }}
brpc_port = {{ starrocks_brpc_port }}
starlet_port = {{ starrocks_starlet_port }}
mem_limit = {{ starrocks_be_memory_limit }}
sys_log_level = INFO
sys_log_dir = {{ starrocks_log_dir }}/be
sys_log_roll_mode = SIZE-MB-128
sys_log_roll_num = 5
