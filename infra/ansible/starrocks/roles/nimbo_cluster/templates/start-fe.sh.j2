#!/bin/bash
set -euo pipefail
# A restarted FE reads its persisted identity. The helper is only for first join.
if [[ ! -s {{ (starrocks_meta_dir ~ '/image/VERSION') | quote }} && -s /etc/starrocks-fe-helper ]]; then
    IFS= read -r helper < /etc/starrocks-fe-helper
    exec {{ (starrocks_link ~ '/fe/bin/start_fe.sh') | quote }} --helper "$helper"
fi
exec {{ (starrocks_link ~ '/fe/bin/start_fe.sh') | quote }}
