          },
          "id": 7,
          "options": {
            "legend": {
              "calcs": [],
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "expr": "sum by (endpoint) (rate(analytics_query_requests_total[$__rate_interval]))",
              "legendFormat": "{{endpoint}}",
              "refId": "A"
            }
          ],
          "title": "Request Rate by Endpoint",
          "type": "timeseries"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "description": "Normal and slow stage latency for the selected execution stages.",
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "line",
                "fillOpacity": 10,
                "lineWidth": 2
              },
              "unit": "s"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 21
          },
          "id": 8,
          "options": {
            "legend": {
              "calcs": [],
              "displayMode": "table",
              "placement": "bottom",
              "showLegend": true
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.50, sum by (le, stage, outcome) (rate(analytics_query_stage_duration_seconds_bucket{stage=~\"$stage\"}[$__rate_interval])))",
              "legendFormat": "p50 {{stage}} / {{outcome}}",
              "refId": "A"
            },
            {
              "expr": "histogram_quantile(0.95, sum by (le, stage, outcome) (rate(analytics_query_stage_duration_seconds_bucket{stage=~\"$stage\"}[$__rate_interval])))",
              "legendFormat": "p95 {{stage}} / {{outcome}}",
              "refId": "B"
            }
          ],
          "title": "Stage Duration",
          "type": "timeseries"
        }
      ],
      "title": "Component diagnostics",
      "type": "row"
    }
  ],
