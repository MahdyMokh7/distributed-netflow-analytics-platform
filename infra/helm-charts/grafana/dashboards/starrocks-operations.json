      "panel-17": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "starrocks"
                      },
                      "group": "mysql",
                      "kind": "DataQuery",
                      "spec": {
                        "dataset": "information_schema",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    CONCAT('BE-', BE_ID) AS backend,\n    ROUND(\n        100 *\n        SUM(\n            CASE\n                WHEN LABELS NOT IN (\n                    'mode=idle',\n                    'mode=guest',\n                    'mode=guest_nice'\n                )\n                THEN VALUE\n                ELSE 0\n            END\n        )\n        /\n        SUM(VALUE),\n        2\n    ) AS cpu_percent\nFROM information_schema.be_metrics\nWHERE NAME='cpu'\nGROUP BY BE_ID\nORDER BY cpu_percent DESC;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "CPU utilization per StarRocks Backend node calculated from BE CPU metrics excluding idle time.",
          "id": 17,
