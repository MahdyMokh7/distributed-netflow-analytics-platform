      "panel-21": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "prometheus"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (partition) (\n  kafka_consumer_fetch_manager_records_lag{job=\"starrocks-writer\",topic=\"multi-version-netflow\"}\n)\n/ scalar(\n  clamp_min(\n    sum(\n      rate(nimbo_StarRocksWriter_records_polled_total{job=\"starrocks-writer\"}[15m])\n    )\n    /\n    clamp_min(\n      count(\n        max by (partition) (\n          kafka_consumer_fetch_manager_records_lag{job=\"starrocks-writer\",topic=\"multi-version-netflow\"}\n        )\n      ),\n      1\n    ),\n    1\n  )\n)",
                        "legendFormat": "P{{partition}}",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Estimated backlog drain time for each partition, using the average throughput per assigned partition from StarRocks workers over 15 minutes. This approximation is required because the workers currently share one Kafka client ID.",
