{
  "annotations": {"list": []},
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "description": "Operational health, throughput, duration, PostgreSQL writes, and exactly-once state for the Nimbo batch processor.",
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Whether Prometheus can scrape the batch-processor runtime endpoint.",
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "text": "DOWN"}, "1": {"color": "green", "text": "UP"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "max(up{job=\"batch-processor\"}) or vector(0)", "refId": "A"}],
      "title": "Application Health",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Whether a scheduled batch execution is currently active.",
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "green", "text": "IDLE"}, "1": {"color": "blue", "text": "RUNNING"}}, "type": "value"}]}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "batch_processor_run_in_progress{job=\"batch-processor\"}", "refId": "A"}],
      "title": "Run State",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Elapsed time since the last successful non-empty batch; warning and critical thresholds are 15 and 30 minutes.",
      "fieldConfig": {"defaults": {"decimals": 0, "noValue": "NO SUCCESS YET", "unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "orange", "value": 900}, {"color": "red", "value": 1800}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "(time() - batch_processor_last_success_timestamp_seconds{job=\"batch-processor\"}) and batch_processor_last_success_timestamp_seconds{job=\"batch-processor\"} > 0", "refId": "A"}],
      "title": "Last Success Age",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Age of the newest Parquet filename timestamp committed to durable processed-file state.",
      "fieldConfig": {"defaults": {"decimals": 0, "noValue": "NO FILE COMMITTED", "unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "orange", "value": 1800}, {"color": "red", "value": 3600}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "(time() - batch_processor_last_processed_file_timestamp_seconds{job=\"batch-processor\"}) and batch_processor_last_processed_file_timestamp_seconds{job=\"batch-processor\"} > 0", "refId": "A"}],
      "title": "Processed File Age",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "DURABLE means processed-file state is persisted in PostgreSQL; FALLBACK means restart safety is degraded.",
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "green", "text": "DURABLE"}, "1": {"color": "red", "text": "FALLBACK"}}, "type": "value"}]}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "id": 5,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "batch_processor_state_fallback_active{job=\"batch-processor\"}", "refId": "A"}],
      "title": "Exactly-Once State",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Whether the next scheduled execution must reuse a failed batch identifier.",
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "green", "text": "CLEAR"}, "1": {"color": "orange", "text": "RETRY PENDING"}}, "type": "value"}]}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "id": 6,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "batch_processor_failed_batch_pending{job=\"batch-processor\"}", "refId": "A"}],
      "title": "Failed Batch Recovery",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Scheduled execution outcomes counted over Grafana's adaptive rate interval.",
      "fieldConfig": {"defaults": {"decimals": 0, "custom": {"drawStyle": "bars", "fillOpacity": 30, "lineWidth": 1}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 4},
      "id": 7,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "increase(batch_processor_runs_total{job=\"batch-processor\"}[$__rate_interval])", "legendFormat": "{{outcome}}", "refId": "A"}],
      "title": "Run Outcomes per Interval",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "95th-percentile run duration by outcome; the red threshold marks the 10-minute schedule interval.",
      "fieldConfig": {"defaults": {"decimals": 1, "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "thresholdsStyle": {"mode": "line"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "orange", "value": 480}, {"color": "red", "value": 600}]}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 4},
      "id": 8,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(batch_processor_run_duration_seconds_bucket{job=\"batch-processor\"}[$__rate_interval])))", "legendFormat": "p95 {{outcome}}", "refId": "A"}],
      "title": "Run Duration p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "95th-percentile duration by bounded processing stage for bottleneck identification.",
      "fieldConfig": {"defaults": {"decimals": 1, "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 4},
      "id": 9,
      "options": {"legend": {"calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, stage) (rate(batch_processor_stage_duration_seconds_bucket{job=\"batch-processor\"}[$__rate_interval])))", "legendFormat": "{{stage}}", "refId": "A"}],
      "title": "Stage Duration p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Files and source records durably completed over Grafana's adaptive rate interval; files use the right axis to avoid scale distortion.",
      "fieldConfig": {"defaults": {"decimals": 0, "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2}, "unit": "short"}, "overrides": [{"matcher": {"id": "byName", "options": "files"}, "properties": [{"id": "custom.axisPlacement", "value": "right"}, {"id": "custom.drawStyle", "value": "bars"}]}]},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 11},
      "id": 10,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "increase(batch_processor_files_processed_total{job=\"batch-processor\"}[$__rate_interval])", "legendFormat": "files", "refId": "A"},
        {"expr": "increase(batch_processor_source_records_total{job=\"batch-processor\"}[$__rate_interval])", "legendFormat": "source records", "refId": "B"}
      ],
      "title": "Committed Input per Interval",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Rows written to PostgreSQL by cube over Grafana's adaptive rate interval.",
      "fieldConfig": {"defaults": {"decimals": 0, "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 11},
      "id": 11,
      "options": {"legend": {"calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "increase(batch_processor_output_rows_total{job=\"batch-processor\"}[$__rate_interval])", "legendFormat": "{{cube}}", "refId": "A"}],
      "title": "PostgreSQL Rows per Interval",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Executor-side PostgreSQL retries and terminal stage failures; failures are red and retries are orange.",
      "fieldConfig": {"defaults": {"decimals": 0, "custom": {"drawStyle": "bars", "fillOpacity": 30, "lineWidth": 1}, "unit": "short"}, "overrides": [{"matcher": {"id": "byRegexp", "options": "/^retry /"}, "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]}, {"matcher": {"id": "byRegexp", "options": "/^failure /"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]}]},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 11},
      "id": 12,
      "options": {"legend": {"calcs": [], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "increase(batch_processor_postgres_retries_total{job=\"batch-processor\"}[$__rate_interval])", "legendFormat": "retry {{cube}}", "refId": "A"},
        {"expr": "increase(batch_processor_stage_failures_total{job=\"batch-processor\"}[$__rate_interval])", "legendFormat": "failure {{stage}}", "refId": "B"}
      ],
      "title": "Retries and Failures",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["nimbo", "batch-processor"],
